# Environment Configuration for News NIT IIT - Sponsor Engine

# System Execution Flags
DRY_RUN=true
APPROVAL_REQUIRED=true
LOG_LEVEL=INFO

# Data Limits
DAILY_OUTREACH_LIMIT=5
MAX_RESEARCH_PER_DAY=20
MAX_SEARCH_REQUESTS=10
MAX_FOLLOWUPS=2

# LLM Provider Configuration (OpenAI, Gemini, or custom API endpoint)
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Search API Configuration
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# Meta / Instagram Developer API Configuration
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# Google Sheets Configuration
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TITLE="News NIT IIT Sponsorship Pipeline"

# Local Storage
SQLITE_DB_PATH=data/sponsor_engine.db
